APP_NAME="The Fanglle II"
APP_ENV=local
APP_KEY=
# Production: false. true shows stack traces with config values; only on your own machine.
APP_DEBUG=false
APP_URL=https://thefanglle.test
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fanglle
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): true, so the staff session cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@thefanglle.example"
MAIL_FROM_NAME="${APP_NAME}"

NIGHT_OPENS_AT=15:00
VENUE_CAPACITY=600
# Test-mode keys only. The app refuses to start unless this begins with xnd_development_.
XENDIT_SECRET_KEY=xnd_development_placeholder
XENDIT_CALLBACK_TOKEN=
# Only for tests/Concurrency; defaults to https://api.xendit.co.
# XENDIT_BASE_URL=
QR_PRIVATE_KEY_PATH=storage/app/keys/qr-private.pem
# Empty locally = Turnstile check skipped.
TURNSTILE_SECRET=
DEMO_MODE=true

# Public POSTs (table holds, guestlist, resend) per IP per minute. tests/Concurrency raises it to 1000.
PUBLIC_POSTS_PER_MINUTE=10
# fanglle:backup (daily 05:00) deletes dumps in storage/app/backups older than this.
BACKUP_KEEP_DAYS=14

# Path to openssl.cnf, needed by `fanglle:keys` on Windows PHP builds. Leave empty elsewhere.
OPENSSL_CONF=
