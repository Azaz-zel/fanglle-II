APP_NAME="The Fanglle II"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fanglle
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@thefanglle.example"
MAIL_FROM_NAME="${APP_NAME}"

NIGHT_OPENS_AT=15:00
# Test-mode keys only. The app refuses to start unless this begins with xnd_development_.
XENDIT_SECRET_KEY=xnd_development_placeholder
XENDIT_CALLBACK_TOKEN=
# Only for tests/Concurrency; defaults to https://api.xendit.co.
# XENDIT_BASE_URL=
QR_PRIVATE_KEY_PATH=storage/app/keys/qr-private.pem
# Empty locally = Turnstile check skipped.
TURNSTILE_SECRET=
DEMO_MODE=true

# Path to openssl.cnf, needed by `fanglle:keys` on Windows PHP builds. Leave empty elsewhere.
OPENSSL_CONF=
